{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customDuotone": false,
			"palette": [
				{ "slug": "base", "color": "#ffffff", "name": "Base" },
				{ "slug": "base-2", "color": "#f4f5f7", "name": "Base alt" },
				{ "slug": "contrast", "color": "#14171c", "name": "Contrast" },
				{ "slug": "contrast-2", "color": "#4a5160", "name": "Contrast soft" },
				{ "slug": "primary", "color": "#1c5d99", "name": "Primary" },
				{ "slug": "primary-dark", "color": "#14456f", "name": "Primary dark" },
				{ "slug": "accent", "color": "#c1653f", "name": "Accent" },
				{ "slug": "border", "color": "#dfe3e8", "name": "Border" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "Georgia, 'Times New Roman', serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "1 — Tight", "size": "0.5rem" },
				{ "slug": "20", "name": "2 — Small", "size": "1rem" },
				{ "slug": "30", "name": "3 — Medium", "size": "1.5rem" },
				{ "slug": "40", "name": "4 — Large", "size": "2.5rem" },
				{ "slug": "50", "name": "5 — Section", "size": "4rem" },
				{ "slug": "60", "name": "6 — Wide", "size": "5rem" },
				{ "slug": "70", "name": "7 — Band", "size": "clamp(4rem, 8vw, 7rem)" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"dimensions": { "minHeight": true }
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "typography": { "textDecoration": "underline" } },
				":focus-visible": {
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": { "fontWeight": "600" },
				"border": { "radius": "4px" },
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": { "color": { "background": "var(--wp--preset--color--primary-dark)" } },
				":focus-visible": {
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
