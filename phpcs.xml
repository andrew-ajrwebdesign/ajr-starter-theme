<?xml version="1.0"?>
<ruleset name="AJR Starter Theme">
    <description>WordPress Coding Standards for AJR Starter Theme.</description>

    <!-- What to scan -->
    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>

    <!-- How to report -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- WordPress ruleset -->
    <rule ref="WordPress">
        <!-- Short array syntax is standard modern PHP and matches AJR Starter Core. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <!-- This scaffold explains itself at length; prose comments are not sentences. -->
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
    </rule>

    <!-- Enforce the correct text domain. Rename it with the rest of style.css's rename table. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ajr-starter-theme"/>
            </property>
        </properties>
    </rule>

    <!-- Match the theme header: Requires at least 6.7, Requires PHP 8.1. -->
    <config name="minimum_supported_wp_version" value="6.7"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
